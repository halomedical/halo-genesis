# ===========================================
# Halo Patient Concierge - Environment Config
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --- Server ---
PORT=3001
NODE_ENV=development

# --- Session ---
# REQUIRED: Generate a strong random secret (e.g. openssl rand -hex 32)
SESSION_SECRET=

# --- Google OAuth 2.0 ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Scopes used by HALO include:
# - https://www.googleapis.com/auth/drive
# - https://www.googleapis.com/auth/calendar.events (read/write bookings)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Google Gemini AI ---
# Get your key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# --- Deepgram (optional) ---
# Medical transcription. Falls back to Gemini if not set.
# Get your key at https://console.deepgram.com/
DEEPGRAM_API_KEY=

# --- URLs ---
# Frontend URL (used for CORS and OAuth redirect)
CLIENT_URL=http://localhost:5173
# Production URL (used for OAuth redirect in production)
# PRODUCTION_URL=https://your-domain.com

# --- Feature flags (frontend) ---
# Set to 'false' to temporarily disable the expanded calendar UI.
VITE_ENABLE_EXPANDED_CALENDAR=true

# --- Billing (frontend extension) ---
# API key for the external MediKredit integration service.
VITE_MEDIKREDIT_API_KEY=
# Optional override for billing service base URL.
VITE_BILLING_API_BASE=https://medikredit-integration-dev-17803b194e77.herokuapp.com

# --- Google Calendar bookings (optional but recommended) ---
# Calendar used to pull today’s bookings for the sidebar calendar.
# If not set, the primary calendar is used.
# BOOKINGS_CALENDAR_ID=your-bookings-calendar-id@group.calendar.google.com

# --- Template request email (optional) ---
# When set, "Request new template" in Settings sends an email to ADMIN_EMAIL.
# ADMIN_EMAIL=admin@halo.africa
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# --- Practice entitlements (Supabase) ---
# Module access (admissions, scribe, billing, admin agent) is controlled in the database.
# See supabase/CONFIG.md and supabase/seed.example.sql. Service role key is server-only.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=

# --- Beamer / Heimdall (optional, server-only) ---
# Shared Drive provisioning is disabled unless all three Workspace values are set.
# Use a dedicated service account with domain-wide delegation for Drive only.
# Never expose these values through VITE_* variables or place them on client devices.
# BEAMER_WORKSPACE_CLIENT_EMAIL=
# BEAMER_WORKSPACE_PRIVATE_KEY=
# BEAMER_WORKSPACE_DELEGATED_SUBJECT=workspace-admin@example.com
# BEAMER_ENROLLMENT_TTL_MINUTES=15
# BEAMER_ONLINE_THRESHOLD_SECONDS=120
# BEAMER_MAX_MOBILE_UPLOAD_BYTES=15728640
# BEAMER_MAX_FILE_UPLOAD_BYTES=10485760
# Production bootstrap remains unavailable until all release metadata is set.
# BEAMER_WINDOWS_INSTALLER_VERSION=1.0.0
# BEAMER_WINDOWS_INSTALLER_URL=https://releases.example.com/beamer-windows-1.0.0.zip
# BEAMER_WINDOWS_INSTALLER_SHA256=

# --- Admin Agent — VPS Platform API ---
# Required to enable the Admin Agent module (auto-provisions VPS accounts for doctors).
# VPS_BASE_URL defaults to https://platform.halo.africa if not set.
VPS_BASE_URL=https://platform.halo.africa
VPS_ADMIN_EMAIL=
VPS_ADMIN_PASSWORD=
