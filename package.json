    "docx": "^9.5.1",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "express-session": "^1.19.0",
    "googleapis": "^171.4.0",
    "mammoth": "^1.11.0",
    "nodemailer": "^8.0.1",
    "pdf-parse": "^2.4.5",
    "ws": "^8.19.0"
  },
