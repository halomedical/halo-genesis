  "main": "index.js",
  "scripts": {
    "dev:server": "nodemon --exec ts-node server/index.ts",
    "dev:shell": "npm run dev --prefix src/shell",
    "dev": "echo \"Unified shell dev server: http://localhost:5173\" && concurrently \"npm run dev:server\" \"wait-on http://localhost:3001/api/health && npm run dev:shell\"",
    "install:shell": "npm ci --prefix src/shell --include=dev",
    "build": "npm run build:shell && tsc",
    "build:server": "tsc",
    "build:shell": "npm run install:shell && npm run build --prefix src/shell",
    "start": "node server/dist/server/index.js",
    "test:calendar": "ts-node server/tests/calendar-normalise.test.ts",
    "test:pdf-hitl": "ts-node server/tests/patientFormDeltas.test.ts && ts-node server/tests/patientSummaryFormEnrich.test.ts && ts-node server/tests/mappingFeedback.test.ts"
  },
  "engines": {
    "node": "20.x"
  },
  "keywords": [],
